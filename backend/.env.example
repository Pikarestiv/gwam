APP_NAME=Gwam
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gwam-api.dumostech.com

FRONTEND_URL=https://gwam.dumostech.com/app
ADMIN_URL=https://gwam.dumostech.com/admin

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=gwam_db
DB_USERNAME=gwam_user
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

SANCTUM_STATEFUL_DOMAINS=gwam.dumostech.com

MAIL_MAILER=smtp
MAIL_HOST=mail.namecheap.com
MAIL_PORT=465
MAIL_USERNAME=noreply@gwam.dumostech.com
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@gwam.dumostech.com
MAIL_FROM_NAME="Gwam 👻"

# Minutes until API tokens expire (default 30 days)
SANCTUM_EXPIRATION_MINUTES=43200

# Paystack (paid room durations). Webhook URL: https://gwam-api.dumostech.com/api/v1/webhooks/paystack
PAYSTACK_SECRET_KEY=
APP_FRONTEND_URL=https://gwam.dumostech.com/app
PRICE_ROOM_72H_KOBO=50000
PRICE_ROOM_168H_KOBO=100000
PRICE_ROOM_720H_KOBO=300000

# Web push: generate with `php artisan gwam:vapid-keys`
VAPID_SUBJECT=mailto:support@gwam.dumostech.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
